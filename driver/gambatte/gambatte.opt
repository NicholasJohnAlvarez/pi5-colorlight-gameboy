# Gambatte core options for the Pi 5 Game Boy (link cable CLIENT).
# Loaded by play.sh with --opts-file. Same format as RetroArch .opt files.
#
# The other Game Boy (here, the 9ft 7in) is the link SERVER. Put the server's
# Wi-Fi IP address in the twelve digit fields below, zero-padded to three
# digits per octet. Example: 192.168.1.20 -> 1 9 2 1 6 8 0 0 1 0 2 0
#
# If the server isn't running, the patched core gives up after 1 second and
# the game boots normally.

# Look and boot logo (needs gbc_bios.bin, 2304 bytes, in the ROM folder)
gambatte_gb_hwmode = "GBC"
gambatte_gb_colorization = "auto"
gambatte_gb_bootloader = "enabled"

# Network link cable
gambatte_gb_link_mode = "Network Client"
gambatte_gb_link_network_port = "56400"
gambatte_show_gb_link_settings = "enabled"
gambatte_gb_link_network_server_ip_1 = "1"
gambatte_gb_link_network_server_ip_2 = "9"
gambatte_gb_link_network_server_ip_3 = "2"
gambatte_gb_link_network_server_ip_4 = "1"
gambatte_gb_link_network_server_ip_5 = "6"
gambatte_gb_link_network_server_ip_6 = "8"
gambatte_gb_link_network_server_ip_7 = "0"
gambatte_gb_link_network_server_ip_8 = "0"
gambatte_gb_link_network_server_ip_9 = "1"
gambatte_gb_link_network_server_ip_10 = "0"
gambatte_gb_link_network_server_ip_11 = "2"
gambatte_gb_link_network_server_ip_12 = "0"
